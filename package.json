    "@payloadcms/richtext-lexical": "^3.90.2",
    "dotenv": "16.4.7",
    "next": "16.4.0",
    "next-intl": "^4.14.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "eslint": "^10.12.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
